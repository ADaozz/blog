---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { absoluteUrl, withBase } from '../lib/urls';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 技术笔记`;
const canonical = absoluteUrl(canonicalPath);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase('/rss.xml', { file: true })} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase('/favicon.svg', { file: true })} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <div class="site">
      <Header />
      <main id="content" class="site-main">
        <div class="shell">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
