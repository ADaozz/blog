---
import { site } from '../data/site';
import { getProjects } from '../lib/content';
import { projectStatusLabel } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getProjects();
const email = site.author.email.trim();
---

<BaseLayout title="About" description={site.author.bio}>
  <p class="kicker">About</p>
  <h1 class="page-title">{site.author.name}</h1>
  <p class="lede">{site.author.bio}</p>

  <section class="section">
    <div class="section-head">
      <h2 class="kicker">Interests</h2>
    </div>
    <ul class="tag-list">
      {site.author.interests.map((item) => <li><span class="tag">{item}</span></li>)}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="kicker">Projects</h2>
    </div>
    {
      projects.length === 0 ? (
        <p class="empty-state">公开项目列表目前为空。</p>
      ) : (
        projects.map((entry) => (
          <article class="project-row">
            <div>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.summary}</p>
              <div class="project-meta">
                <span>状态 {projectStatusLabel[entry.data.status]}</span>
                {entry.data.github && <a href={entry.data.github}>GitHub</a>}
              </div>
            </div>
          </article>
        ))
      )
    }
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="kicker">Contact</h2>
    </div>
    <p>
      GitHub：<a href={site.author.github}>{site.author.github}</a>
    </p>
    {
      email ? (
        <p>
          Email：<a href={`mailto:${email}`}>{email}</a>
        </p>
      ) : (
        <p class="muted">Email 尚未在 `src/data/site.ts` 中配置。</p>
      )
    }
  </section>
</BaseLayout>
