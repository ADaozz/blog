---
import ProjectList from '../components/ProjectList.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getProjects();
---

<BaseLayout title="About" description={site.author.bio}>
  <p class="kicker">About</p>
  <h1 class="page-title">{site.author.name}</h1>
  <p class="lede">{site.author.bio}</p>

  <section class="section">
    <div class="section-head">
      <h2 class="kicker">Interests</h2>
    </div>
    <ul class="tag-list">
      {site.author.interests.map((item) => <li><span class="tag">{item}</span></li>)}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="kicker">Projects</h2>
    </div>
    <ProjectList entries={projects} />
  </section>
</BaseLayout>
