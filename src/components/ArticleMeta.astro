---
import { formatDate } from '../lib/dates';

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  readingTime: number;
  tags: string[];
}

const { publishedAt, updatedAt, readingTime, tags } = Astro.props;
---

<div class="article-meta">
  <time datetime={publishedAt.toISOString()}>发布 {formatDate(publishedAt)}</time>
  {
    updatedAt && (
      <time datetime={updatedAt.toISOString()}>更新 {formatDate(updatedAt)}</time>
    )
  }
  <span>阅读 {readingTime} 分钟</span>
</div>
{
  tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <span class="tag">{tag}</span>
        </li>
      ))}
    </ul>
  )
}
